public class FullnessFactorCalculator {

    // Method to calculate the Fullness Factor (FF)
    public static double calculateFullnessFactor(double calories, double protein, double fiber, double fat) {
        // Calculate each part of the formula
        double term1 = 41.7 / Math.pow(calories, 0.7);
        double term2 = 0.05 * protein;
        double term3 = 6.17E-4 * Math.pow(fiber, 3); //6.17E-4 = 6.17 * 10 i minus 4 potens
        double term4 = -7.25E-6 * Math.pow(fat, 3);
        double term5 = 0.617;

        // Sum the terms
        double fullnessFactor = term1 + term2 + term3 + term4 + term5;

        // Apply the MIN and MAX functions to ensure FF is within the bounds of 0.5 and 5.0
        fullnessFactor = Math.max(0.5, Math.min(5.0, fullnessFactor));

        return fullnessFactor;
    }

    public static void main(String[] args) {
        // Example input values
        double calories = 100;    // CAL (Calories per 100g)
        double protein = 10;      // PR (Protein per 100g)
        double fiber = 5;         // DF (Dietary Fiber per 100g)
        double fat = 10;          // TF (Total Fat per 100g)

        // Calculate Fullness Factor (FF)
        double fullnessFactor = calculateFullnessFactor(calories, protein, fiber, fat);

        // Output the result
        System.out.println("Fullness Factor (FF): " + fullnessFactor);
    }
}
